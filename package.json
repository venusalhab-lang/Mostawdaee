{
  "name": "mostawdaee",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server-dist/server.js",
    "start": "node server-dist/server.js",
    "lint": "tsc --noEmit",
    "cap:assets": "npx @capacitor/assets generate --assetPath assets",
    "cap:sync": "npx cap sync",
    "android:sync": "npm run build && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
