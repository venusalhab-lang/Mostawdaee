    "@emotion/is-prop-valid": "^1.3.3",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@google/genai": "^1.52.0",
    "@supabase/supabase-js": "^2.106.1",
    "compression": "^1.8.2",
    "cordova-plugin-purchase": "^13.16.1",
    "dotenv": "^17.2.3",
    "express": "^4.22.2",
    "firebase": "^12.13.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^18.3.1",
