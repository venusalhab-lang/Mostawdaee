# .env.example
# Server-only. The assistant also needs SUPABASE_SERVICE_ROLE_KEY to check the subscription.
GEMINI_API_KEY=
# Optional, defaults to gemini-3.5-flash
GEMINI_MODEL=
# Optional, assistant questions per store per day (UTC). Defaults to 20; 0 turns the assistant off.
AI_DAILY_QUESTIONS_PER_STORE=

# Supabase Real-time Cloud Integration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (never expose to the Vite client)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Play subscription verification (service account with access to Play Console > API access)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.mostawdaee.app
# Real-time developer notifications (Pub/Sub push to /api/play/rtdn with an OIDC token).
# Audience configured on the push subscription, e.g. https://your-domain/api/play/rtdn
PLAY_RTDN_AUDIENCE=
# Required with the audience: service account email the push subscription signs as. Without it the endpoint answers 503.
PLAY_RTDN_SERVICE_ACCOUNT=

# National e-invoicing (JoFotara). 32 random bytes, hex or base64, e.g. `openssl rand -hex 32`.
# Seals each store's Secret-Key at rest. Without it e-invoicing stays off. Changing it means every store re-enters its Secret-Key.
EINVOICE_ENCRYPTION_KEY=

# Public https origin of this server, baked into the phone build.
# Production: https://app.mostawdaee.com
# (www.mostawdaee.com stays on Vercel as marketing; the live app+API run on app.)
VITE_API_BASE_URL=

# Comma-separated extra browser origins allowed to call /api (Capacitor localhost is built-in).
ALLOWED_ORIGINS=https://www.mostawdaee.com,https://mostawdaee.com,https://app.mostawdaee.com
