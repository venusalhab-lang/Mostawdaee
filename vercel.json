{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/auth/callback",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/auth/callback/",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api", "destination": "/api" },
    { "source": "/api/:path*", "destination": "/api?__p=:path*" },
    { "source": "/auth/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/((?!api(?:/|$)|assets(?:/|$)|.*\\..*).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "server-dist/**"
    }
  }
}
