rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // Phase 3: Primitive Definitions
    // ---------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow get: if true;
      allow write: if false;
    }

    // ---------------------------------------------------------
    // Entity Validations
    // ---------------------------------------------------------

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'sku', 'quantity', 'unitCost', 'sellingPrice', 'status', 'dateAdded'])
             && data.id is string && data.id.size() <= 128
             && data.name is string && data.name.size() <= 200
             && data.sku is string && data.sku.size() <= 64
             && data.quantity is number
             && data.unitCost is number
             && data.sellingPrice is number
             && data.status in ['In Stock', 'Low Stock', 'Out of Stock']
             && data.dateAdded is number;
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['id', 'invoiceNumber', 'date', 'items', 'subtotal', 'taxAmount', 'totalAmount', 'type'])
             && data.id is string
             && data.invoiceNumber is string
             && data.date is number
             && data.items is list
             && data.subtotal is number
             && data.taxAmount is number
             && data.totalAmount is number
             && data.type in ['sale', 'purchase'];
    }

    function isValidVaultTransaction(data) {
      return data.keys().hasAll(['id', 'type', 'category', 'amount', 'timestamp', 'balanceAfter'])
             && data.id is string
             && data.type in ['income', 'expense']
             && data.category in ['sale', 'purchase', 'salary', 'manual', 'other']
             && data.amount is number
             && data.timestamp is number
             && data.balanceAfter is number;
    }

    function isValidStockMovement(data) {
      return data.keys().hasAll(['id', 'productId', 'productName', 'type', 'before', 'after', 'delta', 'timestamp'])
             && data.id is string
             && data.productId is string
             && data.productName is string && data.productName.size() <= 200
             && data.type in ['initial', 'adjustment']
             && data.before is number
             && data.after is number
             && data.delta is number
             && data.timestamp is number
             && (!data.keys().hasAny(['reason']) || (data.reason is string && data.reason.size() <= 300))
             && (!data.keys().hasAny(['userName']) || data.userName is string);
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'salary', 'status', 'hiredDate'])
             && data.id is string
             && data.name is string
             && data.salary is number
             && data.status in ['active', 'on-leave', 'terminated']
             && data.hiredDate is number
             && (!data.keys().hasAny(['currency']) || data.currency in ['JOD', 'ILS', 'USD', 'IQD', 'SAR', 'AED', 'LYD', 'EGP']);
    }

    function isValidPayrollRecord(data) {
      return data.keys().hasAll(['id', 'employeeId', 'employeeName', 'monthYear', 'allowances', 'deductions', 'netSalary', 'paymentDate', 'paymentStatus'])
             && data.id is string
             && data.employeeId is string
             && data.employeeName is string
             && data.monthYear is string
             && data.allowances is number
             && data.deductions is number
             && data.netSalary is number
             && data.paymentDate is number
             && data.paymentStatus in ['pending', 'paid'];
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['id', 'customerId', 'name', 'phone', 'createdAt', 'totalDebt', 'currency'])
             && data.id is string
             && data.customerId is string
             && data.name is string && data.name.size() <= 200
             && data.phone is string && data.phone.size() <= 64
             && data.createdAt is string
             && data.totalDebt is number
             && data.currency in ['JOD', 'ILS', 'USD', 'IQD', 'SAR', 'AED', 'LYD', 'EGP'];
    }

    function isValidCustomerTransaction(data) {
      return data.keys().hasAll(['id', 'transactionId', 'customerId', 'type', 'amount', 'currency', 'exchangeRate', 'date', 'notes', 'remainingBalanceAfter'])
             && data.id is string
             && data.transactionId is string
             && data.customerId is string
             && data.type in ['invoice', 'payment']
             && data.amount is number
             && data.currency in ['JOD', 'ILS', 'USD', 'IQD', 'SAR', 'AED', 'LYD', 'EGP']
             && data.exchangeRate is number
             && data.date is string
             && data.notes is string
             && data.remainingBalanceAfter is number;
    }

    function isValidSettings(data) {
      return (data.get('defaultLanguage', 'en') in ['en', 'ar'])
             && (data.get('theme', 'light') in ['light', 'soft', 'modern'])
             && (data.get('aiVerbosity', 'concise') in ['concise', 'detailed']);
    }

    function isValidVault(data) {
      return data.keys().hasAll(['currentBalance', 'lastUpdated'])
             && data.currentBalance is number
             && data.lastUpdated is number;
    }

    function isValidQuickTransaction(data) {
      return data.keys().hasAll(['type', 'title', 'status', 'userId', 'createdAt'])
             && data.type in ['IN', 'OUT', 'AUDIT']
             && data.title is string && data.title.size() <= 200
             && data.status is string && data.status.size() <= 64
             && data.userId is string && data.userId.size() <= 128;
    }

    function isValidWarehouse(data) {
      return data.keys().hasAll(['id', 'name', 'createdAt'])
             && data.id is string
             && data.name is string && data.name.size() <= 200
             && (!data.keys().hasAny(['location']) || data.location is string)
             && (!data.keys().hasAny(['parentId']) || data.parentId == null || data.parentId is string)
             && data.createdAt is number;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'action', 'details', 'timestamp', 'category', 'userName', 'email'])
             && data.id is string
             && data.action is string && data.action.size() <= 200
             && data.details is string && data.details.size() <= 2000
             && data.timestamp is number
             && data.category in ['product', 'invoice', 'settings', 'employee', 'customer', 'warehouse', 'vault', 'payroll', 'auth']
             && data.userName is string
             && data.email is string;
    }

    // ---------------------------------------------------------
    // Collection Matches
    // ---------------------------------------------------------

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /settings/profile {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidSettings(incoming());
      }

      match /settings/vault {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidVault(incoming());
      }

      match /inventory/{productId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(productId) && isValidProduct(incoming());
        allow update: if isOwner(userId) && isValidProduct(incoming());
        allow delete: if isOwner(userId);
      }

      match /invoices/{invoiceId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(invoiceId) && isValidInvoice(incoming());
        allow update: if isOwner(userId) && isValidInvoice(incoming());
        allow delete: if isOwner(userId);
      }

      match /vault_records/{recordId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(recordId) && isValidVaultTransaction(incoming());
        allow update: if isOwner(userId) && isValidVaultTransaction(incoming());
        allow delete: if isOwner(userId);
      }

      // Immutable audit trail of manual stock changes
      match /stock_movements/{movementId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(movementId) && isValidStockMovement(incoming());
        allow update, delete: if false;
      }

      match /employees/{employeeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(employeeId) && isValidEmployee(incoming());
        allow update: if isOwner(userId) && isValidEmployee(incoming());
        allow delete: if isOwner(userId);
      }

      match /payroll/{payrollId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(payrollId) && isValidPayrollRecord(incoming());
        allow update: if isOwner(userId) && isValidPayrollRecord(incoming());
        allow delete: if isOwner(userId);
      }

      match /customers/{customerId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(customerId) && isValidCustomer(incoming());
        allow update: if isOwner(userId) && isValidCustomer(incoming());
        allow delete: if isOwner(userId);
      }

      match /customer_transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId) && isValidCustomerTransaction(incoming());
        allow update: if isOwner(userId) && isValidCustomerTransaction(incoming());
        allow delete: if isOwner(userId);
      }

      match /audit_logs/{logId} {
        allow get, list: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId && isValidId(logId) && isValidAuditLog(incoming());
        allow update: if request.auth != null && request.auth.uid == userId && isValidAuditLog(incoming());
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /warehouses/{warehouseId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(warehouseId) && isValidWarehouse(incoming());
        allow update: if isOwner(userId) && isValidWarehouse(incoming());
        allow delete: if isOwner(userId);
      }
    }

    // Root-level secure quick actions collection
    match /transactions/{transactionId} {
      allow read, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(transactionId) && incoming().userId == request.auth.uid && isValidQuickTransaction(incoming()) && incoming().createdAt == request.time;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
